---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { CATEGORIES, SITE_NAME, shortTitle, toolHref } from "../lib/content";
import { ICONS } from "../lib/dom";
import { EDITORS } from "../lib/editors";
import { tools } from "../lib/registry";
import "../styles/pdf-editor.css";

const editor = EDITORS.find((e) => e.slug === "edit-pdf")!;
const site = Astro.site ?? new URL("http://localhost:3000");
const url = new URL(`/${editor.slug}`, site).href;
const title = `${editor.title} | ${SITE_NAME}`;
const related = tools.filter((t) => t.category === "pdf");

const I = {
  select: ["M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z", "M13 13l6 6"],
  text: ["M4 7V4h16v3", "M9 20h6", "M12 4v16"],
  whiteout: ["M20 20H7L3 16a2 2 0 0 1 0-2.8l9.6-9.6a2 2 0 0 1 2.8 0l5.6 5.6a2 2 0 0 1 0 2.8L13 20", "M6 11l7 7"],
  highlight: ["M9 11l-6 6v3h9l3-3", "M22 12l-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4"],
  rect: ["M3 5h18v14H3z"],
  ellipse: ["M12 19c4.97 0 9-3.13 9-7s-4.03-7-9-7-9 3.13-9 7 4.03 7 9 7z"],
  line: ["M5 19L19 5"],
  arrow: ["M5 19L19 5", "M9 5h10v10"],
  ink: ["M12 20h9", "M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"],
  image: ["M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z", "M8.5 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z", "M21 15l-5-5L5 21"],
  sign: ["M3 17c3-3 5-9 7-9s-1 9 1 9 3-4 4-4 1 3 3 3 2-1 3-1", "M3 21h18"],
  undo: ["M3 7v6h6", "M21 17a9 9 0 0 0-15-6.7L3 13"],
  redo: ["M21 7v6h-6", "M3 17a9 9 0 0 1 15-6.7L21 13"],
  zoomIn: ["M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z", "M21 21l-4.35-4.35", "M11 8v6", "M8 11h6"],
  zoomOut: ["M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z", "M21 21l-4.35-4.35", "M8 11h6"],
  trash: ["M3 6h18", "M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6", "M10 11v6", "M14 11v6", "M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"],
  open: ["M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z", "M14 2v6h6", "M12 18v-6", "M9 15l3-3 3 3"],
};
type Tool = { id: string; label: string; icon: string[]; hint: string };
const drawTools: Tool[] = [
  { id: "select", label: "Select", icon: I.select, hint: "Select, move and resize" },
  { id: "text", label: "Text", icon: I.text, hint: "Click on the page to type" },
  { id: "whiteout", label: "White-out", icon: I.whiteout, hint: "Drag over text to cover it" },
  { id: "highlight", label: "Highlight", icon: I.highlight, hint: "Drag to highlight" },
  { id: "rect", label: "Rectangle", icon: I.rect, hint: "Drag to draw a rectangle" },
  { id: "ellipse", label: "Ellipse", icon: I.ellipse, hint: "Drag to draw an ellipse" },
  { id: "line", label: "Line", icon: I.line, hint: "Drag to draw a line" },
  { id: "arrow", label: "Arrow", icon: I.arrow, hint: "Drag to draw an arrow" },
  { id: "ink", label: "Draw", icon: I.ink, hint: "Draw freehand" },
];

const steps = [
  "Open a PDF — drag and drop it, or click to browse. It is read on your device and never uploaded.",
  "Pick a tool: add text, cover existing content with white-out, highlight, draw shapes or freehand, insert an image or add your signature.",
  "Select anything you added to move, resize, restyle or delete it. Undo and redo with Ctrl/⌘ Z and Ctrl/⌘ Shift Z.",
  "Rotate, reorder or delete pages from the page list.",
  "Press “Download PDF”. Your edits are written into the original file as real text and vector shapes.",
];
const questions = [
  { q: "Is my PDF uploaded?", a: "No. The editor runs entirely in your browser. Your PDF is opened, edited and saved on your device, and never sent to our server." },
  { q: "Will the text I add be selectable and searchable?", a: "Yes. Text is written into the PDF as real text using the standard PDF fonts (Helvetica, Times and Courier), and shapes and drawings are saved as vector graphics, so nothing is flattened into an image." },
  { q: "Can I change the text that is already in the PDF?", a: "Cover it with the White-out tool, then type the replacement on top with the Text tool. The original page content itself is kept unchanged." },
  { q: "Which characters can I type?", a: "Text uses the standard PDF fonts, which cover Western European languages (Latin-1). Characters outside that set, such as emoji or CJK, are replaced with “?” when you save." },
  { q: "Can I edit password-protected PDFs?", a: "Not yet. Remove the password first, then open the file here." },
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: editor.short,
    description: editor.description,
    url,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any (web browser)",
    browserRequirements: "Requires JavaScript and a modern browser",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: ["Add text, images, shapes, highlights and signatures", "Rotate, reorder and delete pages", "Processes files on your device"],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", site).href },
      { "@type": "ListItem", position: 2, name: `${CATEGORIES.pdf.label} tools`, item: new URL("/tools/pdf", site).href },
      { "@type": "ListItem", position: 3, name: editor.short, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: questions.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Layout title={title} description={editor.description} jsonLd={jsonLd}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/tools/pdf">{CATEGORIES.pdf.label}</a></li>
      <li aria-current="page">{editor.short}</li>
    </ol>
  </nav>

  <header class="page-head">
    <h1>{editor.short}</h1>
    <p class="lead">{editor.description}</p>
  </header>

  <div id="pdfed" class="pdfed">
    <noscript><p class="notice warn">The PDF editor needs JavaScript. Your file is never uploaded.</p></noscript>

    <section class="card upload-card" id="pdfed-start" aria-label="Open a PDF">
      <button type="button" class="drop-zone" id="pdfed-drop" aria-describedby="pdfed-drop-hint">
        <span class="drop-icon"><Icon paths={["M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4", "M17 8l-5-5-5 5", "M12 3v12"]} size={48} strokeWidth={1.5} /></span>
        <span class="drop-text">Drop a PDF to edit</span>
        <span class="drop-subtext" id="pdfed-drop-hint">or click to browse · it stays on your device</span>
        <span class="drop-formats"><span class="format-chip">PDF</span></span>
      </button>
      <input type="file" id="pdfed-file" accept=".pdf,application/pdf" hidden tabindex="-1" aria-label="Choose a PDF file" />
      <div id="pdfed-notices"></div>
    </section>

    <section class="card pdfed-app" id="pdfed-app" aria-label="PDF editor" hidden>
      <div class="pdfed-bar">
        <div class="pdfed-tools" role="toolbar" aria-label="Editing tools" id="pdfed-tools">
          {drawTools.map((t, i) => (
            <button type="button" class="pdfed-tool" data-tool={t.id} aria-pressed={i === 0 ? "true" : "false"} title={`${t.label} — ${t.hint}`} tabindex={i === 0 ? "0" : "-1"}>
              <Icon paths={t.icon} size={18} /><span class="pdfed-tool-label">{t.label}</span>
            </button>
          ))}
          <button type="button" class="pdfed-tool" id="pdfed-add-image" title="Image — insert a PNG or JPG" tabindex="-1">
            <Icon paths={I.image} size={18} /><span class="pdfed-tool-label">Image</span>
          </button>
          <button type="button" class="pdfed-tool" id="pdfed-add-sign" title="Signature — draw or type" tabindex="-1" aria-haspopup="dialog">
            <Icon paths={I.sign} size={18} /><span class="pdfed-tool-label">Sign</span>
          </button>
        </div>
        <div class="pdfed-actions" role="toolbar" aria-label="Document actions" id="pdfed-actions">
          <button type="button" class="btn-icon neutral" id="pdfed-undo" aria-label="Undo" title="Undo (Ctrl/⌘ Z)" disabled><Icon paths={I.undo} size={16} /></button>
          <button type="button" class="btn-icon neutral" id="pdfed-redo" aria-label="Redo" title="Redo (Ctrl/⌘ Shift Z)" disabled><Icon paths={I.redo} size={16} /></button>
          <span class="pdfed-sep" aria-hidden="true"></span>
          <button type="button" class="btn-icon neutral" id="pdfed-zoom-out" aria-label="Zoom out"><Icon paths={I.zoomOut} size={16} /></button>
          <button type="button" class="pdfed-zoom" id="pdfed-zoom-fit" title="Fit to width" aria-label="Zoom 100%, fit to width"><span id="pdfed-zoom-val">100%</span></button>
          <button type="button" class="btn-icon neutral" id="pdfed-zoom-in" aria-label="Zoom in"><Icon paths={I.zoomIn} size={16} /></button>
          <span class="pdfed-sep" aria-hidden="true"></span>
          <button type="button" class="btn-icon" id="pdfed-delete" aria-label="Delete selected item" title="Delete selected (Del)" disabled><Icon paths={I.trash} size={16} /></button>
          <button type="button" class="btn-secondary" id="pdfed-open"><Icon paths={I.open} size={14} /><span>Open another</span></button>
          <button type="button" class="btn-primary" id="pdfed-save"><Icon paths={ICONS.download} size={16} /><span>Download PDF</span></button>
        </div>
      </div>

      <div class="pdfed-props" id="pdfed-props" role="group" aria-label="Style">
        <span class="pdfed-props-title" id="pdfed-props-title">Select</span>
        <label class="pdfed-prop" data-prop="font">
          <span>Font</span>
          <select id="pdfed-font">
            <option value="helvetica">Helvetica</option>
            <option value="times">Times</option>
            <option value="courier">Courier</option>
          </select>
        </label>
        <label class="pdfed-prop" data-prop="size">
          <span>Size</span>
          <input type="number" id="pdfed-size" min="4" max="400" step="1" value="16" inputmode="numeric" />
        </label>
        <span class="pdfed-prop pdfed-toggles" data-prop="style">
          <button type="button" class="pdfed-toggle" id="pdfed-bold" aria-pressed="false" aria-label="Bold" title="Bold"><b>B</b></button>
          <button type="button" class="pdfed-toggle" id="pdfed-italic" aria-pressed="false" aria-label="Italic" title="Italic"><i>I</i></button>
        </span>
        <label class="pdfed-prop" data-prop="color">
          <span id="pdfed-color-label">Colour</span>
          <input type="color" id="pdfed-color" value="#111111" />
        </label>
        <label class="pdfed-prop" data-prop="fill">
          <span>Fill</span>
          <input type="color" id="pdfed-fill" value="#ffffff" />
        </label>
        <label class="pdfed-prop pdfed-check" data-prop="fill-on">
          <input type="checkbox" id="pdfed-fill-on" />
          <span>Filled</span>
        </label>
        <label class="pdfed-prop" data-prop="width">
          <span>Width</span>
          <input type="number" id="pdfed-width" min="0.5" max="40" step="0.5" value="2" inputmode="decimal" />
        </label>
        <span class="pdfed-hint" id="pdfed-hint"></span>
      </div>

      <div id="pdfed-app-notices"></div>

      <div class="pdfed-body">
        <aside class="pdfed-side" aria-labelledby="pdfed-pages-title">
          <h2 class="visually-hidden" id="pdfed-pages-title">Pages</h2>
          <ol class="pdfed-thumbs" id="pdfed-thumbs"></ol>
        </aside>
        <div class="pdfed-stage" id="pdfed-stage" tabindex="-1">
          <div class="pdfed-pages" id="pdfed-pages"></div>
        </div>
      </div>
      <p class="pdfed-foot"><span id="pdfed-filename"></span> · <span id="pdfed-pagecount"></span> · edits stay on this device</p>
    </section>

    <input type="file" id="pdfed-image-input" accept="image/png,image/jpeg,image/webp,image/gif" hidden tabindex="-1" aria-label="Choose an image" />
    <div class="visually-hidden" id="pdfed-live" role="status" aria-live="polite"></div>
  </div>

  <dialog id="pdfed-sign-dialog" aria-labelledby="pdfed-sign-title">
    <div class="warning-modal-container pdfed-sign">
      <div class="warning-modal-header">
        <span class="pdfed-sign-title" id="pdfed-sign-title">Add a signature</span>
        <form method="dialog"><button type="submit" class="btn-modal-close" aria-label="Close"><Icon paths={ICONS.x} size={16} /></button></form>
      </div>
      <div class="warning-modal-body">
        <div class="pdfed-tabs" role="tablist" aria-label="Signature type">
          <button type="button" role="tab" id="pdfed-tab-draw" aria-controls="pdfed-panel-draw" aria-selected="true">Draw</button>
          <button type="button" role="tab" id="pdfed-tab-type" aria-controls="pdfed-panel-type" aria-selected="false" tabindex="-1">Type</button>
        </div>
        <div role="tabpanel" id="pdfed-panel-draw" aria-labelledby="pdfed-tab-draw">
          <canvas class="pdfed-sign-pad" id="pdfed-sign-pad" width="480" height="180" aria-label="Signature pad: draw with a mouse, pen or finger"></canvas>
          <button type="button" class="btn-secondary" id="pdfed-sign-clear">Clear</button>
        </div>
        <div role="tabpanel" id="pdfed-panel-type" aria-labelledby="pdfed-tab-type" hidden>
          <label class="pdfed-sign-field"><span>Your name</span><input type="text" id="pdfed-sign-text" autocomplete="name" maxlength="80" /></label>
          <p class="pdfed-sign-preview" id="pdfed-sign-preview" aria-hidden="true"></p>
        </div>
        <label class="pdfed-prop pdfed-sign-color"><span>Ink colour</span><input type="color" id="pdfed-sign-color" value="#1a2b6d" /></label>
      </div>
      <div class="warning-modal-footer">
        <form method="dialog"><button type="submit" class="btn-secondary">Cancel</button></form>
        <button type="button" class="btn-primary" id="pdfed-sign-insert">Insert signature</button>
      </div>
    </div>
  </dialog>

  <section class="card prose info-grid" aria-label="About this tool">
    <div>
      <h2>How to edit a PDF</h2>
      <ol>{steps.map((s) => <li>{s}</li>)}</ol>
    </div>
    <div>
      <h2>Private by design</h2>
      <p>The editor runs in your browser. Your PDF is never uploaded: it is opened, edited and saved on your device. The original page content is kept intact and your additions are written on top as real, selectable text and vector graphics.</p>
      <p><strong>Keyboard:</strong> Tab to an item you added, move it with the arrow keys (Shift for bigger steps), press Enter to edit text and Delete to remove it. Activating a drawing tool with the keyboard places a new item on the current page.</p>
      <p><a href="/privacy">Read the privacy details</a>.</p>
    </div>
  </section>

  <section class="card prose faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Frequently asked questions</h2>
    {questions.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>

  <section class="card prose" aria-labelledby="related-title">
    <h2 id="related-title">More PDF tools</h2>
    <ul class="tool-links">
      {related.map((t) => <li><a href={toolHref(t)}><span>{shortTitle(t)}</span></a></li>)}
    </ul>
  </section>
</Layout>

<script>
  import "../scripts/editor/pdf/main.ts";
</script>
