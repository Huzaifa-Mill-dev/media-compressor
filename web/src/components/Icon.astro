---
interface Props {
  paths: readonly string[];
  size?: number;
  strokeWidth?: number;
  class?: string;
}
const { paths, size = 18, strokeWidth = 2, class: className } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>{paths.map((d) => <path d={d} />)}</svg>
